+    def _replace_segment_with_segments(self, target_id, segments):
+        for index, seg in enumerate(self._sidecar.segments):
+            if seg.id == target_id:
+                self._sidecar.segments[index : index + 1] = segments
+                return
+        self._sidecar.segments.extend(segments)
+
+    def _reset_ai_segmentation_state(self):
+        self._ai_segmentation_replace = False
+        self._ai_segmentation_target_segment_id = ""
+        self._ai_segmentation_offset_ms = 0
+        self._ai_segmentation_max_ms = 0
+
+    def _segments_from_ai_events(self, text, offset_ms=0, max_ms=0):
+        try:
+            payload = json.loads(self._json_payload_text(text))
+        except (TypeError, ValueError):
+            return []
+
+        if isinstance(payload, dict):
+            events = payload.get("events") or payload.get("segments")
+        elif isinstance(payload, list):
+            events = payload
+        else:
+            events = None
+        if not isinstance(events, list):
+            return []
+
+        active_label = self.label_panel.active_label()
+        max_ms = int(max_ms or self._sidecar.duration_ms or 0)
+        segments = []
+        for event in events:
+            if not isinstance(event, dict):
+                continue
+            start_ms = self._time_text_to_ms(
+                event.get("start_time")
+                or event.get("start")
+                or event.get("begin_time")
+            )
+            end_ms = self._time_text_to_ms(
+                event.get("end_time") or event.get("end")
+            )
+            description = str(
+                event.get("event")
+                or event.get("description")
+                or event.get("action")
+                or ""
+            ).strip()
+            if start_ms is None or end_ms is None or end_ms <= start_ms:
+                continue
+            start_ms += int(offset_ms or 0)
+            end_ms += int(offset_ms or 0)
+            if max_ms:
+                start_ms = max(0, min(start_ms, max_ms))
+                end_ms = max(0, min(end_ms, max_ms))
+            if end_ms <= start_ms:
+                continue
+            label = active_label or self.tr("片段{n}").format(
+                n=len(segments) + 1
+            )
+            segments.append(
+                Segment.new(
+                    label,
+                    start_ms,
+                    end_ms,
+                    fps=self._sidecar.fps,
+                    description=description,
+                )
+            )
+        return segments
+
+    def _json_payload_text(self, text):
+        text = (text or "").strip()
+        if text.startswith("```"):
+            text = re.sub(r"^```(?:json)?\s*", "", text, flags=re.I)
+            text = re.sub(r"\s*```$", "", text)
+        object_start = text.find("{")
+        object_end = text.rfind("}")
+        array_start = text.find("[")
+        array_end = text.rfind("]")
+        if array_start >= 0 and (
+            object_start < 0 or array_start < object_start
+        ):
+            start, end = array_start, array_end
+        elif object_start >= 0 and object_end >= object_start:
+            start, end = object_start, object_end
+        else:
+            start, end = -1, -1
+        if start < 0 or end < start:
+            raise ValueError("No JSON payload found")
+        return text[start : end + 1]
+
+    def _time_text_to_ms(self, text):
+        if not isinstance(text, str):
+            return None
+        match = re.fullmatch(r"\s*(\d{1,2})[:：](\d{2})[:：](\d{2})\s*", text)
+        if not match:
+            return None
+        hours, minutes, seconds = [int(part) for part in match.groups()]
+        return ((hours * 60 + minutes) * 60 + seconds) * 1000
+
+    def _find_segment(self, seg_id):
+        for s in self._sidecar.segments:
+            if s.id == seg_id:
+                return s
+        return None
+
+    def _has_segment_overlap(self, start_ms, end_ms, ignore_id=""):
+        start_ms = int(start_ms)
+        end_ms = int(end_ms)
+        if end_ms <= start_ms:
+            return True
+        for seg in self._sidecar.segments:
+            if ignore_id and seg.id == ignore_id:
+                continue
+            if max(start_ms, seg.start_ms) < min(end_ms, seg.end_ms):
+                return True
+        return False
+
+    def _jump_prev_segment(self):
+        if not self._sidecar.segments:
+            return
+        pos = self.player.position()
+        candidates = sorted(self._sidecar.segments, key=lambda s: s.start_ms)
+        prev = None
+        for s in candidates:
+            if s.start_ms < pos - 1:
+                prev = s
+        if prev:
+            self.player.seek(prev.start_ms)
+            self.timeline.set_selected(prev.id)
+            self.segment_list.select(prev.id)
+
+    def _jump_next_segment(self):
+        if not self._sidecar.segments:
+            return
+        pos = self.player.position()
+        candidates = sorted(self._sidecar.segments, key=lambda s: s.start_ms)
+        for s in candidates:
+            if s.start_ms > pos + 1:
+                self.player.seek(s.start_ms)
+                self.timeline.set_selected(s.id)
+                self.segment_list.select(s.id)
+                return
+
+    # Mark in / out
+    def _mark_in(self):
+        if not self._video_path:
+            return
+        self._pending_in_ms = self.player.position()
+        if (
+            self._pending_out_ms is not None
+            and self._pending_out_ms < self._pending_in_ms
+        ):
+            self._pending_out_ms = None
+        self._refresh_status_bar()
+
+    def _mark_out(self):
+        if not self._video_path:
+            return
+        self._pending_out_ms = self.player.position()
+        if (
+            self._pending_in_ms is not None
+            and self._pending_out_ms < self._pending_in_ms
+        ):
+            self._pending_in_ms, self._pending_out_ms = (
+                self._pending_out_ms,
+                self._pending_in_ms,
+            )
+        self._refresh_status_bar()
+
+    def _commit_from_marks(self):
+        if self._pending_in_ms is None or self._pending_out_ms is None:
+            return
+        start = min(self._pending_in_ms, self._pending_out_ms)
+        end = max(self._pending_in_ms, self._pending_out_ms)
+        if end - start < 50:
+            QMessageBox.information(
+                self,
+                self.tr("Add segment"),
+                self.tr("The marked range is too short."),
+            )
+            return
+        label = self._ensure_active_label_or_prompt()
+        if not label:
+            return
+        if self._has_segment_overlap(start, end):
+            return
+        self._push_undo_snapshot()
+        seg = Segment.new(label, start, end, fps=self._sidecar.fps)
+        self._sidecar.segments.append(seg)
+        self._sidecar.upsert_label(label, self.label_panel.color_for(label))
+        self._pending_in_ms = None
+        self._pending_out_ms = None
+        self._selected_segment_id = seg.id
+        self._mark_dirty()
+        self._refresh_timeline()
+        self._refresh_segment_list()
+        self.timeline.set_selected(seg.id)
+        self.segment_list.select(seg.id)
+        self._refresh_description_editor()
+        self._refresh_status_bar()
+
+    def _undo_last_segment(self):
+        if not self._undo_stack:
+            return
+        self._redo_stack.append(self._segment_snapshot())
+        self._restore_segment_snapshot(self._undo_stack.pop())
+        self._mark_dirty()
+        self._refresh_actions()
+        self._refresh_status_bar()
+
+    def _redo_last_segment(self):
+        if not self._redo_stack:
+            return
+        self._undo_stack.append(self._segment_snapshot())
+        self._restore_segment_snapshot(self._redo_stack.pop())
+        self._mark_dirty()
+        self._refresh_actions()
+        self._refresh_status_bar()
+
+    def _split_selected_segment(self):
+        pos = self.player.position()
+        seg = self._split_target_segment(pos)
+        if not seg:
+            return
+        first = Segment.new(
+            seg.label,
+            seg.start_ms,
+            pos,
+            fps=self._sidecar.fps,
+            description=seg.description,
+        )
+        second = Segment.new(
+            seg.label,
+            pos,
+            seg.end_ms,
+            fps=self._sidecar.fps,
+            description=seg.description,
+        )
+        index = self._sidecar.segments.index(seg)
+        self._push_undo_snapshot(seg.id)
+        self._sidecar.segments[index : index + 1] = [first, second]
+        self._selected_segment_id = second.id
+        self._mark_dirty()
+        self._refresh_timeline()
+        self._refresh_segment_list()
+        self.timeline.set_selected(second.id)
+        self.segment_list.select(second.id)
+        self._refresh_description_editor()
+        self._refresh_actions()
+
+    def _can_split_at_playhead(self):
+        if not self._video_path:
+            return False
+        return self._split_target_segment(self.player.position()) is not None
+
+    def _split_target_segment(self, position_ms):
+        selected = self._find_segment(self._selected_segment_id)
+        if selected and selected.start_ms < position_ms < selected.end_ms:
+            return selected
+        return self._find_segment_at_position(position_ms)
+
+    def _find_segment_at_position(self, position_ms):
+        for seg in self._sidecar.segments:
+            if seg.start_ms < position_ms < seg.end_ms:
+                return seg
+        return None
+
+    def _export_selected_segment(self):
+        seg = self._find_segment(self._selected_segment_id)
+        if not self._video_path or not seg:
+            return
+        if not self._save_dirty_sidecar():
+            return
+        ffmpeg = detect_ffmpeg()
+        if not ffmpeg:
+            QMessageBox.warning(
+                self,
+                self.tr("Export segment"),
+                self.tr(
+                    "ffmpeg was not found. Install ffmpeg or "
+                    "imageio-ffmpeg to export clips."
+                ),
+            )
+            return
+        save_path = self._selected_segment_export_path(seg)
+        if not save_path:
+            return
+        ok, error = self._export_segment_mp4(ffmpeg, seg, save_path)
+        if ok:
+            QMessageBox.information(
+                self,
+                self.tr("Export complete"),
+                self.tr("Exported segment to {path}").format(path=save_path),
+            )
+            return
+        QMessageBox.warning(
+            self,
+            self.tr("Export failed"),
+            error or self.tr("Failed to export the selected segment."),
+        )
+
+    def _selected_segment_export_path(self, seg):
+        stem = os.path.splitext(os.path.basename(self._video_path))[0]
+        default_name = f"{stem}_{seg.id or 'segment'}.mp4"
+        default_path = os.path.join(
+            os.path.dirname(self._video_path), default_name
+        )
+        path, _ = QFileDialog.getSaveFileName(
+            self,
+            self.tr("Export selected segment"),
+            default_path,
+            self.tr("MP4 Video (*.mp4)"),
+        )
+        if not path:
+            return ""
+        if not path.lower().endswith(".mp4"):
+            path += ".mp4"
+        return path
+
+    def _export_segment_mp4(self, ffmpeg, seg, save_path):
+        os.makedirs(os.path.dirname(os.path.abspath(save_path)), exist_ok=True)
+        progress = QProgressDialog(
+            self.tr("Exporting selected segment..."),
+            "",
+            0,
+            0,
+            self,
+        )
+        progress.setCancelButton(None)
+        progress.setWindowTitle(self.tr("Export segment"))
+        progress.setStyleSheet(
+            get_progress_dialog_style(color=get_theme()["text"], height=20)
+        )
+        progress.setMinimumDuration(0)
+        progress.setAutoClose(False)
+        progress.setAutoReset(False)
+        progress.show()
+        QApplication.processEvents()
+        try:
+            ok, error = self._run_segment_ffmpeg(
+                ffmpeg, seg, save_path, re_encode=False
+            )
+            if not ok:
+                ok, error = self._run_segment_ffmpeg(
+                    ffmpeg, seg, save_path, re_encode=True
+                )
+            return ok, error
+        finally:
+            progress.close()
+
+    def _run_segment_ffmpeg(self, ffmpeg, seg, save_path, re_encode):
+        start = ms_to_seconds(seg.start_ms)
+        duration = ms_to_seconds(seg.end_ms) - start
+        if duration <= 0:
+            return False, self.tr("Selected segment duration is invalid.")
+        cmd = [
+            ffmpeg,
+            "-y",
+            "-ss",
+            f"{start:.3f}",
+            "-i",
+            self._video_path,
+            "-t",
+            f"{duration:.3f}",
+            "-map",
+            "0:v:0",
+        ]
+        if re_encode:
+            cmd += [
+                "-c:v",
+                "libx264",
+                "-preset",
+                "veryfast",
+                "-crf",
+                "23",
+            ]
+        else:
+            cmd += ["-c", "copy", "-avoid_negative_ts", "make_zero"]
+        cmd += ["-an", save_path]
+        kwargs = {}
+        if os.name == "nt":
+            kwargs["creationflags"] = getattr(
+                subprocess, "CREATE_NO_WINDOW", 0
+            )
+        result = subprocess.run(
+            cmd,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.PIPE,
+            **kwargs,
+        )
+        if result.returncode == 0:
+            return True, ""
+        error = (result.stderr or b"").decode("utf-8", errors="replace")
+        return False, error.strip()[-400:]
+
+    # Export
+    def _on_export_clicked(self):
+        if not self._video_path or not self._sidecar.segments:
+            QMessageBox.information(
+                self,
+                self.tr("Export Dataset"),
+                self.tr(
+                    "Load a video and annotate at least one segment first."
+                ),
+            )
+            return
+        if not self._save_dirty_sidecar():
+            return
+        folder = os.path.dirname(self._video_path) if self._video_path else ""
+        if not detect_ffmpeg():
+            QMessageBox.warning(
+                self,
+                self.tr("Export Dataset"),
+                self.tr(
+                    "ffmpeg was not found. Install ffmpeg or "
+                    "imageio-ffmpeg to export clips."
+                ),
+            )
+            return
+        dlg = ExportDialog(folder, self._video_path, parent=self)
+        if dlg.exec() != QDialog.DialogCode.Accepted:
+            return
+        cfg = dlg.to_config()
+        if not cfg.output_dir:
+            QMessageBox.warning(
+                self,
+                self.tr("Export Dataset"),
+                self.tr("Output directory is required."),
+            )
+            return
+        if not (cfg.include_video or cfg.include_rawframes):
+            QMessageBox.warning(
+                self,
+                self.tr("Export Dataset"),
+                self.tr("Pick at least one output format."),
+            )
+            return
+
+        self._run_export(cfg)
+
+    def _run_export(self, cfg):
+        progress = QProgressDialog(
+            self.tr("Exporting…"), self.tr("Cancel"), 0, 100, self
+        )
+        progress.setWindowTitle(self.tr("Export Dataset"))
+        progress.setStyleSheet(
+            get_progress_dialog_style(color=get_theme()["text"], height=20)
+        )
+        progress.setMinimumDuration(0)
+        progress.setAutoClose(False)
+        progress.setAutoReset(False)
+        progress.setValue(0)
+
+        controller = ExporterController(cfg, self)
+        self._exporter = controller
+
+        def on_progress(pct, msg):
+            progress.setValue(int(pct))
+            progress.setLabelText(self.tr("Exporting…\n{msg}").format(msg=msg))
+
+        def on_log(line):
+            logger.info(f"[video_classifier export] {line}")
+
+        def on_finished(ok, msg):
+            progress.setValue(100)
+            progress.close()
+            self._exporter = None
+            if ok:
+                QMessageBox.information(self, self.tr("Export complete"), msg)
+            else:
+                QMessageBox.warning(self, self.tr("Export failed"), msg)
+
+        controller.progressChanged.connect(on_progress)
+        controller.logged.connect(on_log)
+        controller.finished.connect(on_finished)
+        progress.canceled.connect(controller.cancel)
+        controller.start()
+
+    # Status bar
+    def _refresh_status_bar(self, extra="", hover_ms=None):
+        parts = []
+        if self._video_path:
+            sd = self._sidecar
+            parts.append(
+                self.tr("FPS: {f:.2f}  Size: {w}x{h}  Duration: {d}").format(
+                    f=sd.fps or 0.0,
+                    w=sd.width or "?",
+                    h=sd.height or "?",
+                    d=ms_to_timecode(sd.duration_ms or 0),
+                )
+            )
+            if self._pending_in_ms is not None:
+                parts.append(
+                    self.tr("In: {t}").format(
+                        t=ms_to_timecode(self._pending_in_ms)
+                    )
+                )
+            if self._pending_out_ms is not None:
+                parts.append(
+                    self.tr("Out: {t}").format(
+                        t=ms_to_timecode(self._pending_out_ms)
+                    )
+                )
+            parts.append(
+                self.tr("Segments: {n}").format(n=len(self._sidecar.segments))
+            )
+            if hover_ms is not None:
+                parts.append(
+                    self.tr("Cursor: {t}").format(t=ms_to_timecode(hover_ms))
+                )
+            if self._dirty:
+                parts.append(self.tr("[modified]"))
+        else:
+            parts.append(self.tr("Drop or open a video to begin."))
+        if extra:
+            parts.append(extra)
+        self.status_label.setText("    ".join(parts))
+
+    def _refresh_actions(self):
+        enabled = bool(self._video_path)
+        edit_enabled = enabled and not self.player.is_playing()
+        self.btn_export_frame.setEnabled(enabled)
+        self.btn_zoom.setEnabled(enabled)
+        self.btn_ai_segment.setEnabled(
+            enabled
+            and self._description_worker is None
+            and self._segmentation_worker is None
+        )
+        for button in (
+            self.btn_back_s,
+            self.btn_prev_frame,
+            self.btn_play,
+            self.btn_next_frame,
+            self.btn_forward_s,
+        ):
+            button.setEnabled(enabled)
+        self.btn_export.setEnabled(
+            enabled or os.path.isdir(self._guess_folder())
+        )
+        self.btn_undo.setEnabled(edit_enabled and bool(self._undo_stack))
+        self.btn_reset.setEnabled(edit_enabled and bool(self._redo_stack))
+        self._refresh_split_action()
+        self.btn_export_selected.setEnabled(
+            edit_enabled
+            and bool(self._find_segment(self._selected_segment_id))
+        )
+        if detect_ffmpeg():
+            self.btn_export.setToolTip(self.tr("Export dataset"))
+            self.btn_export_selected.setToolTip(self.tr("Export segment"))
+        else:
+            self.btn_export.setToolTip(self.tr("ffmpeg required"))
+            self.btn_export_selected.setToolTip(self.tr("ffmpeg required"))
+
+    def _refresh_split_action(self):
+        if not hasattr(self, "btn_split"):
+            return
+        enabled = bool(self._video_path) and not self.player.is_playing()
+        enabled = enabled and self._can_split_at_playhead()
+        if self.btn_split.isEnabled() != enabled:
+            self.btn_split.setEnabled(enabled)
+
+    def _guess_folder(self):
+        return os.path.dirname(self._video_path) if self._video_path else ""
+
+    # Drag & drop
+    def dragEnterEvent(self, event):
+        if event.mimeData().hasUrls():
+            for url in event.mimeData().urls():
+                p = url.toLocalFile()
+                if p and p.lower().endswith(SUPPORTED_VIDEO_EXTS):
+                    event.acceptProposedAction()
+                    return
+        event.ignore()
+
+    def dropEvent(self, event):
+        for url in event.mimeData().urls():
+            p = url.toLocalFile()
+            if p and p.lower().endswith(SUPPORTED_VIDEO_EXTS):
+                event.acceptProposedAction()
+                self.load_video(p)
+                return
+        event.ignore()
+
+    def release_resources(self):
+        if self._released:
+            return
+        self._released = True
+        if self._exporter is not None:
+            try:
+                self._exporter.cancel()
+            except Exception:
+                pass
+        if self._description_worker is not None:
+            try:
+                self._description_worker.cancel()
+                self._description_worker.wait(1000)
+            except Exception:
+                pass
+            self._description_worker = None
+        if self._segmentation_worker is not None:
+            try:
+                self._segmentation_worker.cancel()
+                self._segmentation_worker.wait(1000)
+            except Exception:
+                pass
+            self._segmentation_worker = None
+        for worker in list(self._cancelled_description_workers):
+            try:
+                worker.cancel()
+                worker.wait(1000)
+            except Exception:
+                pass
+        self._cancelled_description_workers = []
+        for worker in list(self._cancelled_segmentation_workers):
+            try:
+                worker.cancel()
+                worker.wait(1000)
+            except Exception:
+                pass
+        self._cancelled_segmentation_workers = []
+        self._ai_segmentation_replace = False
+        self._ai_segmentation_target_segment_id = ""
+        self._ai_segmentation_offset_ms = 0
+        self._ai_segmentation_max_ms = 0
+        if self._ai_progress_dialog is not None:
+            self._ai_progress_dialog.close()
+            self._ai_progress_dialog = None
+        try:
+            self.player.release()
+        except Exception:
+            pass
+
+    def closeEvent(self, event):
+        if not self._save_dirty_sidecar():
+            event.ignore()
+            return
+        self.release_resources()
+        super().closeEvent(event)
diff -ruN a/tools/temporal_tracking_cache.py b/tools/temporal_tracking_cache.py
--- a/tools/temporal_tracking_cache.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/temporal_tracking_cache.py	2026-11-10 07:04:59.727095617 +0000
@@ -0,0 +1,54 @@
+"""Bounded, in-process memoization of exactly matching SAM video chunks."""
+from collections import OrderedDict
+import hashlib
+import json
+import numpy as np
+
+
+class TrackingChunkCache:
+    def __init__(self, limit=128):
+        self.limit = limit
+        self.entries = OrderedDict()
+
+    @staticmethod
+    def fingerprints(paths):
+        result = []
+        for path in paths:
+            before = path.stat()
+            with path.open('rb') as stream:
+                digest = hashlib.file_digest(stream, 'sha256').hexdigest()
+            after = path.stat()
+            if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
+                raise ValueError('图片在计算期间发生变化，请重新生成预览。')
+            result.append((str(path.resolve()), digest))
+        return tuple(result)
+
+    @staticmethod
+    def key(fingerprints, box, carry, rotor, margins):
+        if carry is None:
+            seed = ('box', tuple(float(x) for x in box))
+        else:
+            packed = np.packbits(np.asarray(carry, dtype=bool), bitorder='little')
+            seed = ('mask', tuple(carry.shape), hashlib.sha256(packed.tobytes()).hexdigest())
+        # Margins affect the returned boxes even when the underlying masks match.
+        margin_key = json.dumps(margins, sort_keys=True, separators=(',', ':')) if rotor else None
+        return (fingerprints, seed, bool(rotor), margin_key)
+
+    def get(self, key):
+        value = self.entries.get(key)
+        if value is None: return None
+        self.entries.move_to_end(key)
+        boxes, evidence, mask, shape = value
+        carry = np.unpackbits(mask, count=int(np.prod(shape)), bitorder='little').astype(bool).reshape(shape)
+        return ([None if b is None else list(b) for b in boxes],
+                [None if b is None else list(b) for b in evidence], carry)
+
+    def put(self, key, boxes, evidence, carry):
+        if carry is None: return
+        shape = tuple(carry.shape)
+        packed = np.packbits(np.asarray(carry, dtype=bool).reshape(-1), bitorder='little')
+        self.entries[key] = (tuple(None if b is None else tuple(b) for b in boxes),
+                             tuple(None if b is None else tuple(b) for b in evidence),
+                             packed, shape)
+        self.entries.move_to_end(key)
+        while len(self.entries) > self.limit: self.entries.popitem(last=False)
diff -ruN a/tools/temporal_tracking_inspect.py b/tools/temporal_tracking_inspect.py
--- a/tools/temporal_tracking_inspect.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/temporal_tracking_inspect.py	2026-11-10 07:04:59.727095617 +0000
@@ -0,0 +1,35 @@
+"""Inspect one keyframe's SAM local seed mask without changing annotations."""
+from pathlib import Path
+import tempfile
+import numpy as np
+from PIL import Image
+from tools.temporal_tracking_math import local_crop_window, crop_box_coordinates, mask_box
+
+
+def inspect_keyframe(predictor, image_path, box, points, jobroot):
+    image_path, jobroot = Path(image_path), Path(jobroot)
+    with Image.open(image_path) as source:
+        size = source.size
+        window = local_crop_window(box, size)
+        resolution = 512 if points else 256
+        with tempfile.TemporaryDirectory(prefix='inspect_', dir=jobroot) as folder:
+            dest = Path(folder)/'000000.jpg'
+            source.convert('RGB').crop(tuple(window)).resize((resolution,resolution),Image.Resampling.LANCZOS).save(dest,quality=98)
+            state = predictor.init_state(folder,offload_video_to_cpu=True,offload_state_to_cpu=True)
+            kwargs = {}
+            if points:
+                arr = np.asarray(points,dtype=float)
+                if arr.ndim != 2 or arr.shape[1] != 3 or not np.isfinite(arr).all() or not np.isin(arr[:,2], [0,1]).all():
+                    raise ValueError('提示点格式无效。')
+                xy=(arr[:,:2]-np.asarray(window[:2]))*resolution/(window[2]-window[0])
+                if np.any(xy<0) or np.any(xy>=resolution):
+                    raise ValueError('提示点超出局部范围，请调整点位后再查看。')
+                kwargs={'points':xy.astype(np.float32),'labels':arr[:,2].astype(np.int32)}
+            _,_,logits=predictor.add_new_points_or_box(state,0,1,box=np.asarray(crop_box_coordinates(box,window,resolution=resolution),np.float32),**kwargs)
+            mask=(logits[0,0]>0).cpu().numpy()
+            del state,logits
+    # Save only a transparent visual overlay, never alter input images/annotations.
+    visible=Image.fromarray(mask.astype(np.uint8)*255).resize((window[2]-window[0],window[3]-window[1]),Image.Resampling.NEAREST)
+    overlay=Image.new('RGBA',size,(0,0,0,0));rgba=Image.new('RGBA',visible.size,(25,235,130,0));rgba.putalpha(visible.point(lambda p: 115 if p else 0));overlay.paste(rgba,tuple(window[:2]))
+    path=jobroot/'keyframe_mask.png';overlay.save(path)
+    return {'overlay':str(path),'window':window,'resolution':resolution,'mask_pixels':int(mask.sum()),'bbox_in_crop':mask_box(mask),'image_size':size}
diff -ruN a/tools/temporal_tracking_math.py b/tools/temporal_tracking_math.py
--- a/tools/temporal_tracking_math.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tools/temporal_tracking_math.py	2026-11-10 07:04:59.727095617 +0000
@@ -0,0 +1,248 @@
+"""Dependency-light geometry shared by the GUI and isolated model process."""
+import numpy as np
+
+
+def mask_box(logits, soft=False):
+    """Use only soft pixels connected to an actual positive foreground seed.
+
+    The mask used as tracking memory stays at zero threshold. This optional
+    display extent admits a narrow low-contrast halo, never a new object when
+    the model has no positive foreground at all.
+    """
+    strong = logits > 0
+    yy, xx = np.nonzero(strong)
+    if not len(xx): return None
+    box = [int(xx.min()), int(yy.min()), int(xx.max()+1), int(yy.max()+1)]
+    if not soft: return list(map(float, box))
+    h, w = logits.shape
+    pad_x = max(2, int(np.ceil((box[2]-box[0])*.08)))
+    pad_y = max(2, int(np.ceil((box[3]-box[1])*.08)))
+    x0, y0, x1, y1 = max(0, box[0]-pad_x), max(0, box[1]-pad_y), min(w, box[2]+pad_x), min(h, box[3]+pad_y)
+    allowed = logits[y0:y1, x0:x1] > -2.0
+    region = strong[y0:y1, x0:x1].copy()
+    for _ in range(max(pad_x, pad_y)+2):
+        p = np.pad(region, 1)
+        grown = np.logical_or.reduce([p[dy:dy+region.shape[0], dx:dx+region.shape[1]]
+                                      for dy in range(3) for dx in range(3)]) & allowed
+        if np.array_equal(grown, region): break
+        region = grown
+    yy, xx = np.nonzero(region)
+    return [float(xx.min()+x0), float(yy.min()+y0), float(xx.max()+x0+1), float(yy.max()+y0+1)]
+
+
+def learn_edge_margins(samples):
+    """Outward margins from confirmed human examples, independently per edge."""
+    relative, pixels = [], []
+    for human, model in samples:
+        if model is None: continue
+        model, human = np.asarray(model), np.asarray(human)
+        wh = np.maximum(model[2:]-model[:2], 1)
+        margins = np.maximum(0, (human-model)*np.array([-1, -1, 1, 1]))
+        # A very loose or mismatched prompt must not enlarge every later box.
+        if box_iou(human, model) < .65: continue
+        rel = np.minimum(margins/np.tile(wh, 2), .12)
+        relative.append(rel); pixels.append(np.minimum(margins, np.tile(wh, 2)*.12))
+    if not relative: return {'relative': [0.]*4, 'pixels': [0.]*4}
+    return {'relative': np.quantile(relative, .8, axis=0).tolist(),
+            'pixels': np.quantile(pixels, .8, axis=0).tolist()}
+
+
+def apply_edge_margins(box, margins, size):
+    if box is None: return None
+    box = np.asarray(box, dtype=float)
+    wh = np.tile(box[2:]-box[:2], 2)
+    # Preserve a small blur margin as the object recedes; do not force a fixed
+    # universal padding on targets that the human framed tightly.
+    pad = np.maximum(np.asarray(margins['relative'])*wh, .5*np.asarray(margins['pixels']))
+    result = box+pad*np.array([-1, -1, 1, 1])
+    return np.clip(result, 0, np.tile(size, 2)).tolist()
+
+
+def preserve_nearby_outer_edges(box, original, evidence=None):
+    """Avoid shaving a few pixels off a plausible existing box in rotor mode."""
+    if box is None or original is None or box_iou(box, original) < .72:
+        return box, False
+    box, original = np.asarray(box, dtype=float), np.asarray(original, dtype=float)
+    tolerance = np.maximum(2., .08*np.tile(np.maximum(box[2:]-box[:2], original[2:]-original[:2]), 2))
+    outward = (original-box)*np.array([-1, -1, 1, 1])
+    keep = (outward > 0) & (outward <= tolerance)
+    if evidence is not None:
+        # Keep a plausible old edge when an outward change comes only from
+        # estimated padding, rather than newly visible foreground pixels.
+        observed_outward = (np.asarray(evidence)-original)*np.array([-1, -1, 1, 1])
+        keep |= (outward < 0) & (-outward <= tolerance) & (observed_outward <= .5)
+    result = box.copy(); result[keep] = original[keep]
+    return result.tolist(), bool(keep.any())
+
+
+def box_iou(a, b):
+    a, b = np.asarray(a), np.asarray(b)
+    wh = np.maximum(0, np.minimum(a[2:], b[2:])-np.maximum(a[:2], b[:2]))
+    intersection = float(np.prod(wh))
+    union = float(np.prod(a[2:]-a[:2])+np.prod(b[2:]-b[:2])-intersection)
+    return intersection / union if union > 0 else 0.0
+
+
+def merge_directions(left, right, start, end, preserve_edges=False):
+    output = {}
+    for i in range(start, end+1):
+        a, b = left.get(i), right.get(i)
+        reasons = []
+        if a is not None and b is not None:
+            if box_iou(a, b) < .6:
+                reasons.append('双向跟踪分歧')
+                box = a if i-start <= end-i else b
+            else:
+                if preserve_edges:
+                    # Both masks support the same target. Averaging coordinates
+                    # can discard a thin arm seen in only one direction.
+                    aa, bb = np.asarray(a), np.asarray(b)
+                    box = np.r_[np.minimum(aa[:2], bb[:2]),
+                                np.maximum(aa[2:], bb[2:])].tolist()
+                    scale = np.tile(np.maximum(aa[2:]-aa[:2], bb[2:]-bb[:2]), 2)
+                    if np.any(np.abs(aa-bb) > np.maximum(2., .1*scale)):
+                        reasons.append('双向外缘分歧，请核对机臂范围')
+                else:
+                    t = (i-start)/max(1, end-start)
+                    box = ((1-t)*np.asarray(a)+t*np.asarray(b)).tolist()
+        else:
+            box = a if a is not None else b
+            if left and right and box is not None:
+                reasons.append('一个方向丢失目标')
+        if box is None:
+            reasons.append('未检出：不自动补框，已有标注保留')
+        output[i] = {'box': box, 'reasons': reasons}
+    return output
+
+
+def local_crop_window(box, size):
+    """Square source ROI with context; coordinates are never rounded as boxes."""
+    box = np.asarray(box, dtype=float)
+    width, height = size
+    side = min(width, height, max(128, int(np.ceil(3*np.max(box[2:]-box[:2])))))
+    center = (box[:2]+box[2:])/2
+    x = int(np.clip(np.floor(center[0]-side/2), 0, width-side))
+    y = int(np.clip(np.floor(center[1]-side/2), 0, height-side))
+    return [x, y, x+side, y+side]
+
+
+def crop_box_coordinates(box, window, inverse=False, resolution=256):
+    if box is None: return None
+    window = np.asarray(window, dtype=float)
+    origin = np.tile(window[:2], 2)
+    scale = (window[2]-window[0])/resolution
+    box = np.asarray(box, dtype=float)
+    return (box*scale+origin if inverse else (box-origin)/scale).tolist()
+
+
+def local_size_supported(sequence, index):
+    """Check observed neighbouring masks, never interpolate a missing box."""
+    box = sequence.get(index)
+    if box is None: return False
+    wh = np.asarray(box, float)[2:]-np.asarray(box, float)[:2]
+    neighbours = [np.asarray(sequence[j], float)[2:]-np.asarray(sequence[j], float)[:2]
+                  for j in range(index-2,index+3)
+                  if j != index and sequence.get(j) is not None]
+    if len(neighbours) < 2: return False
+    reference = np.median(neighbours, axis=0)
+    return bool(np.all(wh > 0) and np.all(reference > 0) and
+                np.all(wh/reference > .7) and np.all(wh/reference < 1.4))
+
+
+def combine_local_extent(coarse, local, size, reference_aspect=None,
+                         neighbour_support=False):
+    """Retain image-supported edges, rejecting a local mask on the background.
+
+    This must never manufacture a detection when the video tracker lost it.
+    Rejected/missing local evidence keeps the coarse draft with a review reason.
+    """
+    if coarse is None:
+        return None, ['未检出：不自动补框，已有标注保留']
+    if local is None:
+        return list(coarse), ['局部精修未检出，请核对外缘']
+    coarse, local = np.asarray(coarse, float), np.asarray(local, float)
+    a, b = coarse[2:]-coarse[:2], local[2:]-local[:2]
+    intersection = np.maximum(0, np.minimum(coarse[2:], local[2:])-np.maximum(coarse[:2], local[:2]))
+    contained = np.prod(intersection)/max(1., min(np.prod(a), np.prod(b)))
+    shift = np.linalg.norm((coarse[:2]+coarse[2:]-local[:2]-local[2:])/2)
+    # A small full-frame mask often sees only the fuselage. Rejecting an
+    # enlarged local mask solely for being wider cuts the arms back off.
+    # Permit this bounded size disagreement only when adjacent LOCAL masks
+    # also observe this size and the coarse foreground is contained in it.
+    large = np.any(b > 2.2*np.maximum(a,4.))
+    supported_expansion = (neighbour_support and contained >= .85 and
+                           np.all(b <= 3.5*np.maximum(a,4.)))
+    if (np.any(b <= 0) or contained < .65 or
+            shift > max(8., .45*np.linalg.norm(np.maximum(a,b))) or
+            (large and not supported_expansion) or np.any(b < .35*a)):
+        return coarse.tolist(), ['局部轮廓与跟踪不一致，请核对目标']
+    outer = np.r_[np.minimum(coarse[:2], local[:2]), np.maximum(coarse[2:], local[2:])]
+    result = outer.copy()
+    rejected = []
+    if reference_aspect is not None and np.isfinite(reference_aspect) and reference_aspect > 0:
+        # Local video sees more pixels of this target. Coarse evidence may
+        # restore a missing arm, but must not reintroduce a distant roof/branch.
+        # Human aspect is a weak rejection check on LARGE extra extensions,
+        # never a forced output size or an interpolated replacement rectangle.
+        result = local.copy()
+        growth = (local-outer)*np.array([1,1,-1,-1])
+        tolerance = np.maximum(2., .12*np.tile(b,2))
+        def error(box):
+            wh = np.maximum(box[2:]-box[:2], 1e-6)
+            return abs(np.log((wh[1]/wh[0])/reference_aspect))
+        for edge in np.argsort(growth/tolerance):
+            candidate = result.copy(); candidate[edge] = outer[edge]
+            if (growth[edge] > tolerance[edge] and error(candidate) > .18 and
+                    error(candidate) > error(result)+.08):
+                rejected.append(int(edge))
+            else:
+                result = candidate
+    result = np.clip(result, 0, np.tile(size, 2))
+    difference = np.abs(local-coarse)
+    reasons = []
+    if large and supported_expansion:
+        reasons.append('局部连续轮廓补回机臂，请核对外缘')
+    if rejected:
+        reasons.append('已抑制不符人工框比例的额外扩张，请核对外缘')
+    if np.any(difference > np.maximum(3., .15*np.tile(np.maximum(a,b),2))):
+        reasons.append('局部与全图外缘分歧，请核对机臂范围')
+    return result.tolist(), reasons
+
+
+def rescue_painted_extent(coarse, local, size, reference_aspect, neighbour_support):
+    """Conservative preview candidate when painted local evidence was rejected.
+
+    This is not an accuracy check. Require consecutive size support, substantial
+    overlap, and a width close to the whole-image target, so roof-sized local
+    masks remain rejected. Preserve both sources' measured outer edges.
+    """
+    if coarse is None or local is None or not neighbour_support or reference_aspect is None:
+        return None
+    coarse,local=np.asarray(coarse,float),np.asarray(local,float)
+    if coarse.shape!=(4,) or local.shape!=(4,) or not np.isfinite(coarse).all() or not np.isfinite(local).all() or not np.isfinite(reference_aspect) or reference_aspect <= 0:
+        return None
+    cw,ch=coarse[2:]-coarse[:2];lw,lh=local[2:]-local[:2]
+    if min(cw,ch,lw,lh)<=0:return None
+    intersection=np.maximum(0,np.minimum(coarse[2:],local[2:])-np.maximum(coarse[:2],local[:2]))
+    coverage=float(np.prod(intersection)/max(1.,cw*ch))
+    height_limit=min(1.8,max(.5,1.8*reference_aspect))
+    if not (.7<=lw/cw<=1.3 and coverage>=.7 and lh/cw<=height_limit
+            and coarse[1]-local[1]<=.25*cw and local[3]-coarse[3]>max(2.,.05*cw)):
+        return None
+    outer=np.r_[np.minimum(coarse[:2],local[:2]),np.maximum(coarse[2:],local[2:])]
+    return np.clip(outer,0,np.tile(size,2)).tolist()
+
+
+def interval_reference_aspect(anchors, index, start, end):
+    """Use only this interval's human endpoints, preserving local recompute."""
+    ratios = {}
+    for endpoint in (start,end):
+        if endpoint in anchors:
+            box = np.asarray(anchors[endpoint],float)
+            wh = box[2:]-box[:2]
+            if np.all(np.isfinite(wh)) and np.all(wh > 0):
+                ratios[endpoint] = wh[1]/wh[0]
+    if not ratios: return None
+    if len(ratios)==1: return float(next(iter(ratios.values())))
+    t = np.clip((index-start)/max(1,end-start),0,1)
+    return float(np.exp((1-t)*np.log(ratios[start])+t*np.log(ratios[end])))
