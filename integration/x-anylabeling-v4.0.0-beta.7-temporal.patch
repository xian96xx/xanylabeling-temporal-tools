+        upload_btn.clicked.connect(self._upload_labels)
+        cancel_btn = QPushButton(self.tr("Cancel"))
+        cancel_btn.setObjectName("XvaDialogSecondaryButton")
+        cancel_btn.setStyleSheet(get_cancel_btn_style())
