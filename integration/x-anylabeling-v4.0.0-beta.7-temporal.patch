+                "target_id": getattr(shape, "target_id", None),
+                "global_track_id": getattr(shape, "global_track_id", None),
+                "category_track_id": getattr(shape, "category_track_id", None),
+                "track_id": getattr(shape, "track_id", None),
+                "id": getattr(shape, "id", None),
+            }
+
+        if not isinstance(attributes, dict):
+            attributes = {}
+
+        def identity_field(name):
+            return cls._identity_value(
+                attributes.get(name, top_level.get(name))
+            )
+
+        category = cls._identity_value(
+            attributes.get("category", top_level.get("category"))
+        )
+        category_track_id = identity_field("category_track_id")
+        if category and category_track_id:
+            category_track_id = f"{category}:{category_track_id}"
+
+        track_id = identity_field("track_id") or cls._identity_value(
+            top_level.get("id")
