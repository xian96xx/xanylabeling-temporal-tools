+    @staticmethod
+    def _apply_rectangle_edge_delta(shape_data, edge_delta):
+        """Apply left/top/right/bottom deltas to a JSON rectangle shape.
+
+        The update is rejected if it would invert or collapse the rectangle,
+        preventing malformed boxes from being written to future frames.
+        """
+        points = shape_data.get("points", [])
+        if not isinstance(points, list) or len(points) not in (2, 4):
+            return False
+        try:
+            xs = [float(point[0]) for point in points]
+            ys = [float(point[1]) for point in points]
+        except (TypeError, ValueError, IndexError):
+            return False
+
+        left, top, right, bottom = min(xs), min(ys), max(xs), max(ys)
+        d_left, d_top, d_right, d_bottom = edge_delta
+        new_left = left + d_left
+        new_top = top + d_top
+        new_right = right + d_right
+        new_bottom = bottom + d_bottom
+        if new_right <= new_left or new_bottom <= new_top:
+            return False
+
+        updated_points = []
+        for point in points:
+            x, y = float(point[0]), float(point[1])
+            new_x = new_left if abs(x - left) <= abs(x - right) else new_right
+            new_y = new_top if abs(y - top) <= abs(y - bottom) else new_bottom
+            updated_points.append([new_x, new_y])
+        shape_data["points"] = updated_points
+        return True
