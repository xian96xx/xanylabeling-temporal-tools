+    @classmethod
+    def _shape_matches_tracking_identity(cls, shape_data, identities):
+        candidate = cls._shape_tracking_identity(shape_data)
+        strong_keys = ("target_id", "global_track_id", "category_track_id", "track_id")
+        for identity in identities:
+            if any(
+                identity.get(key)
+                and candidate.get(key)
+                and identity[key] == candidate[key]
+                for key in strong_keys
+            ):
+                return True
+
+            has_shared_strong_key = any(
+                identity.get(key) and candidate.get(key)
+                for key in strong_keys
+            )
+            if has_shared_strong_key:
+                continue
+
+            if not identity.get("group_id") or not candidate.get("group_id"):
+                continue
+            if identity["group_id"] != candidate["group_id"]:
+                continue
+
+            identity_label = identity.get("label")
+            candidate_label = candidate.get("label")
+            if (
+                identity_label
+                and candidate_label
+                and identity_label != candidate_label
+            ):
+                continue
+            return True
+        return False
