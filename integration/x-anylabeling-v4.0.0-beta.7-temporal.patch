+    @classmethod
+    def _rectangle_edge_delta(cls, before_shape, after_shape):
+        before = cls._rectangle_bounds(before_shape)
+        after = cls._rectangle_bounds(after_shape)
+        if before is None or after is None:
+            return None
+        delta = tuple(after[i] - before[i] for i in range(4))
+        if all(abs(value) < 1e-7 for value in delta):
+            return None
